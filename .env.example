# ─── Frontend environment (Next.js) ───────────────────────────────────────────
# Copy this file to `.env.local` and adjust values. Only variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser. These are validated at startup by
# src/config/env.ts (Zod) — a missing/invalid value fails the build loudly.

# Base URL of the backend API (include the /api suffix if your server uses one).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Display name used in <title>, the sidebar brand, etc.
NEXT_PUBLIC_APP_NAME=Indian Health System

# Deployment environment: development | staging | production
NEXT_PUBLIC_ENV=development

# Google Identity client id (public — safe to expose). Leave blank to hide the
# "Continue with Google" button. Must match GOOGLE_CLIENT_ID in the backend .env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key (public). Enable Maps JavaScript API + Places
# API + Geocoding API in Google Cloud, then restrict the key by HTTP referrer.
# Blank = maps show a static placeholder instead of the interactive map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared parent domain for auth cookies — lets a session started here be read
# by the patient/admin apps too (single sign-on across the 3 apps).
# Dev: "localhost". Prod: ".yourdomain.com" (leading dot optional).
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# Base URLs of the other apps in the platform (this one, frontend-doctor, is
# the doctor subdomain; frontend-patient is the main domain).
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
NEXT_PUBLIC_DOCTOR_URL=http://doctor.localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3002

# Public LiveKit SFU URL for video consultations (same as the backend's
# LIVEKIT_URL). Blank = video calling is disabled.
NEXT_PUBLIC_LIVEKIT_URL=wss://<your-project>.livekit.cloud
