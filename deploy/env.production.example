# ─── Production env template ──────────────────────────────────────────────────
# Used in two places:
#   1. Locally:  copy to <project>/.env.production  (read by `next build` in Docker)
#   2. On the VM: copy to /home/ubuntu/isd-doctor/.env (read by docker compose)
#
# Both must contain the same values. These values are baked into the browser
# bundle at build time, so editing the VM .env alone will NOT change the app —
# rebuild + push + pull the image instead.
#
# NEXT_PUBLIC_API_URL must be reachable FROM THE USER'S BROWSER, not from the
# container. Do not use localhost unless the backend is on the same machine as
# the browser.
NEXT_PUBLIC_API_URL=http://16.179.242.134:5000/api

NEXT_PUBLIC_APP_NAME=Indian Health System
NEXT_PUBLIC_ENV=production

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# On a raw IP / single host, leave blank (host-only cookie, no cross-app SSO).
# With a real domain later: .yourdomain.com
NEXT_PUBLIC_COOKIE_DOMAIN=

# All three must be valid URLs (Zod validates them) even if not deployed yet.
NEXT_PUBLIC_PATIENT_URL=http://16.179.242.134:3000
NEXT_PUBLIC_DOCTOR_URL=http://16.179.242.134:3001
NEXT_PUBLIC_ADMIN_URL=http://16.179.242.134:3002

NEXT_PUBLIC_LIVEKIT_URL=
